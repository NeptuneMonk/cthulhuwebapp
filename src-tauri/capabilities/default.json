{
  "identifier": "default",
  "description": "Cthulhu desktop node capabilities",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        { "sidecar": true, "name": "bin/cthulhu-api" },
        { "sidecar": true, "name": "bin/kubo" }
      ]
    },
    "shell:allow-spawn",
    "shell:allow-stdin-write"
  ]
}
