{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "Cthulhu",
  "version": "0.1.0",
  "identifier": "com.cthulhu.node",
  "build": {
    "frontendDist": "../frontend/build",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "cd ../frontend && yarn start",
    "beforeBuildCommand": "cd ../frontend && yarn build"
  },
  "app": {
    "title": "Cthulhu - Decentralized Social",
    "windows": [
      {
        "title": "Cthulhu",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "bin/cthulhu-api",
      "bin/kubo"
    ]
  },
  "plugins": {
    "shell": {
      "sidecar": true
    }
  }
}
